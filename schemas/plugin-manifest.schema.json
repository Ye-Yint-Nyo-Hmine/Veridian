{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veridian.dev/schemas/plugin-manifest.schema.json",
  "title": "Veridian brick manifest",
  "description": "Parsed from veridian.toml at the root of a brick directory. Declares identity, how to spawn the brick, what contracts it implements, and what capabilities it needs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "protocol", "spawn", "implements"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(/[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
    },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "protocol": { "type": "string", "pattern": "^veridian/[0-9]+\\.[0-9]+$" },
    "runtime": { "type": "string", "enum": ["python", "node", "other"] },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string" }
      }
    },
    "implements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "methods"],
        "properties": {
          "contract": { "type": "string" },
          "methods": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "env_passthrough": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
    },
    "optional_dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "description": "Third-party packages this brick needs at runtime. When present, the brick is resolved into its own isolated environment on install (a private venv for python, a local node_modules for node) instead of sharing the kernel's interpreter. Bricks with no dependencies table keep running under ${python} / ${node} as before.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python": {
          "description": "PEP 508 requirement strings, resolved with uv into a private venv.",
          "type": "array",
          "items": { "type": "string" }
        },
        "python_version": {
          "description": "Interpreter constraint passed to `uv venv --python` (e.g. \"3.13\", \">=3.12,<3.14\").",
          "type": "string"
        },
        "node": {
          "description": "package name -> semver range, written to a generated package.json and installed with npm into a local node_modules.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
