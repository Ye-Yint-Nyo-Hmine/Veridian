{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veridian.dev/schemas/protocol/envelope.schema.json",
  "title": "JSON-RPC 2.0 envelope (Veridian profile)",
  "description": "Veridian uses object params only. One message per NDJSON line.",
  "$defs": {
    "Id": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string" }
      ]
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/Id" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    },
    "Notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    },
    "SuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/Id" },
        "result": {}
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": { "type": "object" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "oneOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }] },
        "error": { "$ref": "#/$defs/Error" }
      }
    },
    "Message": {
      "oneOf": [
        { "$ref": "#/$defs/Request" },
        { "$ref": "#/$defs/Notification" },
        { "$ref": "#/$defs/SuccessResponse" },
        { "$ref": "#/$defs/ErrorResponse" }
      ]
    },
    "StreamDelta": {
      "type": "object",
      "required": ["request_id"],
      "properties": {
        "request_id": { "$ref": "#/$defs/Id" }
      }
    }
  }
}
