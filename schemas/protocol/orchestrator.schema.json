{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veridian.dev/schemas/protocol/orchestrator.schema.json",
  "title": "orchestrator contract",
  "description": "Drives the whole agent loop through host.contract.call. Because it is a brick, replacing it replaces the agent architecture.",
  "$defs": {
    "run_params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "workspace_root"],
      "properties": {
        "goal": { "type": "string" },
        "workspace_root": { "type": "string" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_iterations": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "run_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "iterations", "summary"],
      "properties": {
        "status": { "type": "string", "enum": ["completed", "failed", "max_iterations"] },
        "iterations": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string" },
        "usage": {
          "description": "Cumulative token counts across the run's inference calls. Omitted when no provider reported usage.",
          "$ref": "https://veridian.dev/schemas/protocol/common.schema.json#/$defs/Usage"
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "event", "data"],
      "properties": {
        "request_id": { "$ref": "https://veridian.dev/schemas/protocol/envelope.schema.json#/$defs/Id" },
        "event": { "type": "string", "enum": ["step", "tool", "message", "log", "usage"] },
        "data": { "type": "object" }
      }
    },
    "compact_params": {
      "description": "Ask the orchestrator to compress the working context it holds for a session. Optional method: additive, so a stack whose orchestrator predates it is not broken and a caller must degrade gracefully on method_not_found.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": { "type": "string" }
      }
    },
    "compact_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["compacted", "noop", "unsupported"] },
        "summary": { "type": "string" },
        "turns_before": { "type": "integer", "minimum": 0 },
        "turns_after": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
