# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Per-brick isolated environments (`veridian brick install`): the python venv lives under
# `.veridian/` (covered below); node bricks get a local node_modules.
node_modules/

# Windows crash dumps
*.stackdump

# Brick runtime state / conformance probe artifacts
.veridian/
_probe*.txt

# Secrets — never commit provider keys or local env overrides
.env
.env.*
!.env.example
*.pem
*.key
